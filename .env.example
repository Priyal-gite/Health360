# Optional Flask development server settings.
FLASK_DEBUG=false
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Optional: paste Tableau Share > Copy Link URLs after publishing.
# Leave blank to use the Flask-hosted synthetic dashboard/story outline.
TABLEAU_DASHBOARD_URL=
TABLEAU_STORY_URL=

# Database extraction is disabled unless explicit approval is confirmed.
# Use a least-privilege, read-only account and keep secrets outside source control.
DATABASE_URL=
SOURCE_QUERY=
EXTRACTION_APPROVED=false
